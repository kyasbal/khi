// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
	"name": "khi-dev",
	"build": {
		"context": ".",
		"dockerfile": "./Dockerfile"
	},

	// since node_modules is too HEAVY, remove it from mounts.
	"mounts": [
		"source=khi_node_modules,target=${containerWorkspaceFolder}/web/node_modules,type=volume"
	],

	// volume mount will be mounted as root:root. Make it vscode:vscode
	"postAttachCommand": "chown -R vscode:vscode ${containerWorkspaceFolder}/web/node_modules",

	"containerEnv": {
		"KHI_SERVER_HOST": "localhost",
		"KHI_SERVER_PORT": "8080",
		"KHI_FRONTEND_STATIC_FILE_FOLDER": "${containerWorkspaceFolder}/web/dist/frontend"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"Angular.ng-template",
				"golang.go",
				"lucono.karma-test-explorer",
				"syler.sass-indented",
				"dbaeumer.vscode-eslint"
			]
		}
	}
}
